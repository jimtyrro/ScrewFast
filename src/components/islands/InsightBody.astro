---
// The editable region for a single insight article: cover image, ToC
// sidebar shell (populated client-side by scanning rendered heading ids),
// title, and rich-text body. Registered in src/lib/tina/islands.ts and
// rendered both here (initial page load) and by the tina-island endpoint
// (live overlay re-render while editing).
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CustomComponentsMap } from '@tinacms/astro/types';
import H2 from '@components/mdx/H2.astro';
import H3 from '@components/mdx/H3.astro';
import H4 from '@components/mdx/H4.astro';
import H5 from '@components/mdx/H5.astro';
import H6 from '@components/mdx/H6.astro';
import type { InsightsQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: InsightsQuery['insights'] | null;
}

const { data } = Astro.props;

// Slugged heading overrides so TinaMarkdown output carries the same `id`
// attributes the ToC script (src/pages/insights/[id].astro) expects to find
// via `article.querySelectorAll('h1, h2, h3, h4, h5, h6')`.
const components: CustomComponentsMap = { h2: H2, h3: H3, h4: H4, h5: H5, h6: H6 };
---

{data && (
  <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
    <div>
      <div class="h-64 overflow-hidden rounded-lg shadow-lg md:h-auto">
        <img
          class="h-full w-full object-cover object-center"
          src={data.cardImage}
          alt={data.cardImageAlt}
          draggable={'false'}
          loading="eager"
          decoding="async"
          data-tina-field={tinaField(data, 'cardImage')}
        />
      </div>
      <div
        id="progress-mobile"
        class="fixed top-0 left-0 h-2 w-full bg-linear-to-r from-orange-400/30 to-orange-400 md:hidden">
      </div>
      <div id="pin" class="mt-10 hidden space-y-4 md:block">
        <div class="h-px w-full overflow-hidden bg-neutral-300 dark:bg-neutral-700">
          <div
            id="progress"
            class="h-px w-full bg-linear-to-r from-orange-400/30 to-orange-400">
          </div>
        </div>
        <p class="text-sm text-pretty text-neutral-500">
          Table of Contents:
        </p>
        <div id="toc" class="">
          <ul
            class="space-y-2 text-base text-pretty text-neutral-700 transition duration-300 dark:text-neutral-400">
          </ul>
        </div>
      </div>
    </div>

    <div class="md:pt-8">
      <h1
        class="mb-4 text-center text-2xl font-bold text-balance text-neutral-800 sm:text-3xl md:mb-6 md:text-left dark:text-neutral-200"
        data-tina-field={tinaField(data, 'title')}>
        {data.title}
      </h1>

      <article
        class="text-lg text-pretty text-neutral-700 dark:text-neutral-300"
        data-tina-field={tinaField(data, 'body')}>
        <TinaMarkdown content={data.body} components={components} />
      </article>
    </div>
  </div>
)}

---
// The editable region for a single product: hero, tabs (description,
// specifications, blueprints). Registered in src/lib/tina/islands.ts and
// rendered both here (initial page load) and by the tina-island endpoint
// (live overlay re-render while editing).
import { tinaField } from '@tinacms/astro/tina-field';
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import type { ProductsQuery } from '../../../tina/__generated__/types';

interface Props {
  data?: ProductsQuery['products'] | null;
}

const { data } = Astro.props;
---

{data && (
  <>
    <section
      class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
      <div>
        <p
          id="fadeText"
          class="mb-8 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300"
          data-tina-field={tinaField(data, 'main')}>
          {data.main?.content}
        </p>
      </div>
      <div
        class="flex flex-col items-center justify-between space-y-4 sm:flex-row sm:space-y-0">
        <div id="fadeInUp">
          <h1
            class="block text-4xl font-bold tracking-tighter text-neutral-800 sm:text-5xl md:text-6xl lg:text-7xl dark:text-neutral-200"
            data-tina-field={tinaField(data, 'title')}>
            {data.title}
          </h1>
          <p
            class="text-lg text-neutral-600 dark:text-neutral-400"
            data-tina-field={tinaField(data, 'description')}>
            {data.description}
          </p>
        </div>
        <div>
          <img
            id="fadeInMoveRight"
            src={data.main?.imgMain}
            class="w-[600px]"
            alt={data.main?.imgAlt}
            loading="eager"
            decoding="async"
            data-tina-field={tinaField(data, 'main')}
          />
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14">
      <nav
        class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
        aria-label="Tabs"
        role="tablist">
        {data.tabs?.map((tab, index) => tab && (
          <ProductTabBtn
            title={tab.title}
            id={tab.id}
            dataTab={tab.dataTab}
            first={index === 0}
          />
        ))}
      </nav>

      <div class="mt-12 md:mt-16">
        <div id="tabs-with-card-1" role="tabpanel">
          <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
            <div class="grid gap-12 md:grid-cols-2">
              <div class="lg:w-3/4">
                <h2
                  class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:leading-tight lg:text-4xl dark:text-neutral-200"
                  data-tina-field={tinaField(data, 'longDescription')}>
                  {data.longDescription?.title}
                </h2>
                <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
                  {data.longDescription?.subTitle}
                </p>
                <p class="mt-5">
                  <PrimaryCTA
                    title={data.longDescription?.btnTitle ?? ''}
                    url={data.longDescription?.btnURL ?? '#'}
                  />
                </p>
              </div>

              <div class="space-y-6 lg:space-y-10">
                {data.descriptionList?.map(item => item && (
                  <div class="flex">
                    <div>
                      <h3 class="text-base font-bold text-neutral-800 sm:text-lg dark:text-neutral-200">
                        {item.title}
                      </h3>
                      <p class="mt-1 text-neutral-600 dark:text-neutral-400">
                        {item.subTitle}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div id="tabs-with-card-2" class="hidden" role="tabpanel">
          <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
            <div class="grid w-full grid-cols-1 gap-x-16 md:grid-cols-2">
              <div class="max-w-md space-y-6">
                {data.specificationsLeft?.map(spec => spec && (
                  <div>
                    <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                      {spec.title}
                    </h3>
                    <p class="text-neutral-600 dark:text-neutral-400">
                      {spec.subTitle}
                    </p>
                  </div>
                ))}
              </div>
              {data.specificationsRight && data.specificationsRight.length > 0 ? (
                <div class="mt-6 max-w-md space-y-6 md:mt-0 md:ml-auto">
                  {data.specificationsRight.map(spec => spec && (
                    <div>
                      <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                        {spec.title}
                      </h3>
                      <p class="text-neutral-600 dark:text-neutral-400">
                        {spec.subTitle}
                      </p>
                    </div>
                  ))}
                </div>
              ) : data.tableData && data.tableData.length > 0 ? (
                <div class="mt-6 space-y-6 md:mt-0 md:ml-auto">
                  <div class="flex flex-col">
                    <div class="-m-1.5 overflow-x-auto">
                      <div class="inline-block min-w-full p-1.5 align-middle">
                        <div class="overflow-hidden">
                          <table class="min-w-full divide-y divide-neutral-300 dark:divide-neutral-700">
                            <thead>
                              <tr>
                                {data.tableData[0]?.feature?.map(header => (
                                  <th
                                    scope="col"
                                    class="px-6 py-3 text-start text-xs font-medium text-neutral-500 uppercase dark:text-neutral-500">
                                    {header}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody class="divide-y divide-neutral-300 dark:divide-neutral-700">
                              {data.tableData.map(row =>
                                row?.description?.map(rowData => (
                                  <tr>
                                    {rowData?.cells?.map(cellValue => (
                                      <td class="px-6 py-4 text-sm font-medium whitespace-nowrap text-neutral-600 dark:text-neutral-400">
                                        {cellValue}
                                      </td>
                                    ))}
                                  </tr>
                                ))
                              )}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ) : null}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="tabs-with-card-3" class="hidden" role="tabpanel">
      <div class="mx-auto mb-20 flex w-full md:mb-28 2xl:w-4/5">
        <div
          class="relative top-12 left-12 z-10 overflow-hidden rounded-xl shadow-lg md:top-16 md:left-12 md:-ml-12 lg:ml-0">
          {data.blueprints?.first && (
            <img
              src={data.blueprints.first}
              class="h-full w-full object-cover object-center"
              alt="Blueprint Illustration"
              loading="lazy"
              decoding="async"
              data-tina-field={tinaField(data, 'blueprints')}
            />
          )}
        </div>

        <div class="relative right-12 overflow-hidden rounded-xl shadow-xl">
          {data.blueprints?.second && (
            <img
              src={data.blueprints.second}
              class="h-full w-full object-cover object-center"
              alt="Blueprint Illustration"
              loading="lazy"
              decoding="async"
              data-tina-field={tinaField(data, 'blueprints')}
            />
          )}
        </div>
      </div>
    </div>
  </>
)}
